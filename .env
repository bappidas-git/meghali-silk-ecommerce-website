# =============================================================================
# Development Environment Configuration
# =============================================================================
#
# Default: the live Laravel API on Cloudways (https://core.meghalisilk.in).
# Every storefront and admin request goes to that server and its MySQL
# database — there is no mock data in this mode.
#
# TO WORK OFFLINE AGAINST THE JSON SERVER MOCK INSTEAD:
#   1. Comment out the live block below and uncomment the JSON Server block
#   2. Run: npm run dev   (starts the mock API on :3001 alongside the app)
#   3. Restart the dev server after any .env change
#
# To verify the live API end to end (writes to the real database!):
#   npm run test:live
#
# IMPORTANT: Never commit credentials to version control.
# =============================================================================

# API Configuration - JSON Server for local development
# REACT_APP_API_URL=http://localhost:3001
# REACT_APP_USE_MOCK_API=true

# API Configuration - Live Laravel + MySQL server (Cloudways)
REACT_APP_API_URL=https://core.meghalisilk.in/api/v1
REACT_APP_USE_MOCK_API=false


# App Information (update for each project)
REACT_APP_NAME=Meghali's Silk
REACT_APP_VERSION=1.0.0

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false

# Build Configuration
GENERATE_SOURCEMAP=true

# Payment Gateway (for production - Razorpay)
# REACT_APP_RAZORPAY_KEY_ID=your_razorpay_key_id

# Shiprocket (for production)
# REACT_APP_SHIPROCKET_EMAIL=your_shiprocket_email
